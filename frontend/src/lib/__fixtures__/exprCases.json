{
  "description": "表达式白名单的共用用例表（issue #181）。Go 侧 backend/internal/expr/expr_shared_test.go 与前端 expr.cases.test.ts 各跑一遍：任一侧语法改动与另一侧不一致，两边必有一边变红。valid 只表达「语法是否放行」，不代表字段存在（字段检查只在前端）。",
  "cases": [
    { "name": "物理列裸名", "expr": "price", "valid": true },
    { "name": "算术复合", "expr": "price * quantity", "valid": true },
    { "name": "反引号限定名", "expr": "`db.tbl.col`", "valid": true },
    { "name": "裸限定名", "expr": "db.tbl.col", "valid": true },
    { "name": "双引号限定名", "expr": "\"quoted.col\"", "valid": true },
    { "name": "括号优先级", "expr": "(a + b) * 2", "valid": true },
    { "name": "一元负号", "expr": "-price", "valid": true },
    { "name": "count 星号", "expr": "count(*)", "valid": true },
    { "name": "大写聚合函数", "expr": "SUM(amount)", "valid": true },
    { "name": "嵌套聚合", "expr": "min(max(price), 1)", "valid": true },
    { "name": "浮点字面量", "expr": "1.5", "valid": true },
    { "name": "字符串字面量", "expr": "'fixed'", "valid": true },
    { "name": "小数字面量的减法", "expr": "price - 0.1 * tax", "valid": true },
    { "name": "串联运算符", "expr": "a || b", "valid": true },
    { "name": "减负数", "expr": "1 - -1", "valid": true },
    { "name": "空格分隔的负号", "expr": "- -1", "valid": true },
    { "name": "负号加括号", "expr": "-(-1)", "valid": true },
    { "name": "字面量内的双减号", "expr": "'--'", "valid": true },
    { "name": "两个连续单引号转义", "expr": "'it''s'", "valid": true },
    { "name": "空字符串字面量", "expr": "''", "valid": true },
    { "name": "函数空参", "expr": "sum()", "valid": true },
    { "name": "取模", "expr": "a % 7", "valid": true },

    { "name": "分号截断", "expr": "price; DROP TABLE users", "valid": false },
    { "name": "行注释", "expr": "price -- comment", "valid": false },
    { "name": "块注释", "expr": "price /* sneaky */ + 1", "valid": false },
    { "name": "UNION 注入", "expr": "price UNION SELECT 1", "valid": false },
    { "name": "OR 恒真", "expr": "price OR 1=1", "valid": false },
    { "name": "子查询", "expr": "(SELECT max(id) FROM users)", "valid": false },
    { "name": "INSERT", "expr": "INSERT INTO t VALUES (1)", "valid": false },
    { "name": "越权函数 pg_sleep", "expr": "pg_sleep(10)", "valid": false },
    { "name": "越权函数 LOAD_FILE", "expr": "LOAD_FILE('/etc/passwd')", "valid": false },
    { "name": "自定义函数名", "expr": "my_func(price)", "valid": false },
    { "name": "嵌套越权函数", "expr": "sum(pg_sleep(1))", "valid": false },
    { "name": "保留字作列名", "expr": "select", "valid": false },
    { "name": "保留字作函数", "expr": "union(price)", "valid": false },
    { "name": "空表达式", "expr": "   ", "valid": false },
    { "name": "悬空运算符", "expr": "price +", "valid": false },
    { "name": "括号不配对", "expr": "(price + 1", "valid": false },
    { "name": "裸星号", "expr": "*", "valid": false },
    { "name": "星号连算", "expr": "price * *", "valid": false },
    { "name": "逗号悬空", "expr": "a, b", "valid": false },
    { "name": "美元符", "expr": "price $ 1", "valid": false },
    { "name": "反引号不配对", "expr": "`price", "valid": false },
    { "name": "双引号不配对", "expr": "\"price", "valid": false },
    { "name": "单引号不配对", "expr": "'abc", "valid": false },
    { "name": "反引号内分号", "expr": "`price; drop`", "valid": false },
    { "name": "一元位行注释", "expr": "--foo", "valid": false },
    { "name": "一元位行注释接数字", "expr": "--0", "valid": false },
    { "name": "负号后接行注释", "expr": "- --x", "valid": false },
    { "name": "括号内一元位行注释", "expr": "(--foo)", "valid": false },
    { "name": "数字间行注释", "expr": "1 -- 2", "valid": false },
    { "name": "列名后中文注释", "expr": "x --注释", "valid": false },
    { "name": "串联后落一元位行注释", "expr": "a||--b", "valid": false },
    { "name": "反斜杠移位注释逃逸", "expr": "'a\\' + ' OR 1=1 -- '+'b'", "valid": false },
    { "name": "反斜杠紧贴闭合引号", "expr": "'a\\'", "valid": false },
    { "name": "反斜杠转义单引号", "expr": "'it\\'s'", "valid": false },
    { "name": "反斜杠开头", "expr": "'\\abc'", "valid": false },
    { "name": "括号内一元位反斜杠", "expr": "(-'a\\' )", "valid": false },
    { "name": "非数字开头的小数点标识", "expr": "a.1.2", "valid": true }
  ]
}
