{
  "name": "data-insights-frontend",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@12.4.2",
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/only-pnpm.mjs",
    "dev": "node scripts/check-port.mjs && vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "build:check": "pnpm check && pnpm test",
    "api:gen": "openapi-typescript ../api/openapi.yaml -o src/idls/gen_types.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/react": "^10.75.0",
    "antd": "^6.6.4",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-intl": "^12.1.1",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "biome check --no-errors-on-unmatched"
    ],
    "*.{json,css,md}": [
      "biome format --no-errors-on-unmatched"
    ]
  },
  "description": "",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC"
}
